D CHR01 3A 			
D NUM01 3S 2		
D CON01 C CONST('ab"c')	
D NUM02 2S 
D CON02 C CONST(100)			
C *ENTRY PLIST			
C PARM  CODE			
C MOVE CODE CHR01		
C MOVE 55.2  NUM01		
C MOVE 10    NUM02		
C CHR01 IFEQ '001'		
C NUM01 ANDLT 100		
C NUM01 ADD  NUM02  NUM01	
C CHR01 IFEQ '001'		
C NUM01 ANDLT 100		
C NUM01 ADD  NUM02  NUM01	
C ELSE		
C SELEC				
C CHR01 WHEQ '001'		
C CALL 'P001'			
C PARM CHR01			
C PARM NUM01			
C OTHER				
C MOVE 55.2  NUM01		
C ENDSL			
C NUM01 SUB  NUM02  NUM01	
C NUM02 DOWNE 20		
C EXSR #SUB01			
C ENDDO	
C ENDIF	
C ELSE				
C NUM01 SUB  NUM02  NUM01	
C NUM02 DOWNE 20		
C EXSR #SUB01			
C ENDDO	
C ENDIF				
C NUM02 DOWNE 20		
C EXSR #SUB01			
C ENDDO				
C NUM02 DOUNE 20		
C EXSR #SUB01			
C ENDDO			
C #SUB01 BEGSR			
C NUM02 ADD 1 NUM02		
C #SUB01 ENDSR			
C SELEC				
C CHR01 WHEQ '001'		
C CALL 'P001'			
C PARM CHR01			
C PARM NUM01			
C OTHER				
C MOVE 55.2  NUM01		
C ENDSL		
C NUM01 DSPLY
C 'END' DSPLY	
C 1 DO 10 NUM01
C 'DOLOOP' DSPLY	
C ENDDO	
C RETURN